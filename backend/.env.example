# Comma-separated list of frontend origins allowed to call this API.
# Dev default is localhost:3001; in production set this to the real domain,
# e.g. CORS_ORIGINS=https://kcopiglobal.co.ke
CORS_ORIGINS=http://localhost:3001

# Secret used to sign admin JWTs. MUST be changed before any real deployment —
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-deploying

# Optional: overrides the default sqlite:///tembotrails.db path.
# DATABASE_URL=sqlite:////data/kcopiglobal.db

# Gmail account used to send enquiry notifications and newsletter welcome
# emails. EMAIL_APP_PASSWORD is a Gmail "app password" (not the account's
# normal login password) — generate one at myaccount.google.com/apppasswords.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
